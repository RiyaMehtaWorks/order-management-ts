# Server port
PORT=5001

# OPTIONAL: paste your MongoDB connection string here to persist data in MongoDB.
# Leave it EMPTY (or delete the line) to run the app with a built-in in-memory store
# (great for local dev / demos - no DB setup needed, data resets on restart).
# Example: mongodb+srv://user:password@cluster0.mongodb.net/order-management
MONGO_URI=

# Comma-separated list of allowed frontend origins for CORS
CLIENT_ORIGIN=http://localhost:5173
